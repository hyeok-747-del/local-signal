# 실제 값은 .env.local 또는 Vercel 환경변수에만 입력하세요. API_SETUP.md 참고.
# 공공데이터포털 소상공인시장진흥공단_상가(상권)정보 API 인증키 (Decoding 권장)
# 브라우저용 NEXT_PUBLIC_ 변수로 만들지 마세요. 실제 값은 .env.local에만 입력.
PUBLIC_DATA_API_KEY=
# Vercel Secret 별칭(배포 시 PUBLIC_DATA_API_KEY 값을 DATA_API_KEY로 등록)
# DATA_API_KEY는 서버에서만 읽으며 지정 시 PUBLIC_DATA_API_KEY보다 우선합니다.
DATA_API_KEY=
# NAVER API HUB 블로그/지역/검색어 트렌드 공통 서버 인증 (Maps 및 NCP IAM 키와 다름)
# X-NCP-APIGW-API-KEY-ID 에 전달할 Client ID
NAVER_API_HUB_CLIENT_ID=
# X-NCP-APIGW-API-KEY 에 전달할 Client Secret
NAVER_API_HUB_CLIENT_SECRET=
# 지도 브라우저 SDK 식별자는 공개되며 도메인 제한이 필요합니다. Secret은 넣지 마세요.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# 4단계 선택 기능
OPENAI_API_KEY=
# Responses API 사용 가능한 모델명을 입력합니다. 미설정 시 AI 기능 비활성화.
OPENAI_MODEL=
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
